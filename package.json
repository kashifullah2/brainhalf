{
  "name": "@workspace/ocr-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:api": "pnpm build && NODE_OPTIONS=\"--dns-result-order=ipv4first\" wrangler pages dev",
    "build": "vite build --config vite.config.ts && pnpm prerender",
    "prerender": "node scripts/prerender-public.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "deploy": "pnpm build && pnpm db:migrate:remote && pnpm deploy:worker && pnpm deploy:pages",
    "deploy:worker": "pnpm --filter brainhalf-processor exec wrangler deploy",
    "deploy:pages": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" wrangler pages deploy dist --project-name brainhalf",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:worker": "tsc -p queue-worker/tsconfig.json --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:server && pnpm typecheck:worker",
    "probe:ocr": "node scripts/probe-openai.mjs",
    "db:migrate:local": "wrangler d1 migrations apply brainhalf-ocr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply brainhalf-ocr-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^3.2.6",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^3.6.0",
    "localforage": "^1.10.0",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-zoom-pan-pinch": "^4.0.4",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5"
  }
}
