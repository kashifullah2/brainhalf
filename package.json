{
  "name": "brainhalf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @brainhalf/workers db:migrate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:web": "cd apps/web && wrangler pages deploy",
    "deploy:studio": "cd apps/studio && wrangler pages deploy",
    "deploy:workers": "cd apps/workers && wrangler deploy",
    "deploy:all": "turbo run deploy"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "turbo": "latest",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.0.0"
}
