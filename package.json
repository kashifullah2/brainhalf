{
  "name": "brainhalf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm build && wrangler pages dev",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:worker": "pnpm --filter brainhalf-processor run typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:server && pnpm typecheck:test && pnpm typecheck:worker",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck:all && pnpm lint && pnpm test && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply brainhalf-ocr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply brainhalf-ocr-db --remote",
    "deploy": "NODE_OPTIONS=--dns-result-order=ipv4first CLOUDFLARE_ACCOUNT_ID=12fc31472161e3ebb8a01b4722ec1725 wrangler pages deploy dist --project-name brainhalf",
    "deploy:pages": "NODE_OPTIONS=--dns-result-order=ipv4first CLOUDFLARE_ACCOUNT_ID=12fc31472161e3ebb8a01b4722ec1725 wrangler pages deploy dist --project-name brainhalf",
    "deploy:worker": "NODE_OPTIONS=--dns-result-order=ipv4first CLOUDFLARE_ACCOUNT_ID=12fc31472161e3ebb8a01b4722ec1725 pnpm --filter brainhalf-processor run deploy",
    "deploy:all": "pnpm run deploy:pages && pnpm run deploy:worker"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^4.0.4",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.0.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8",
    "vite": "^6.2.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
