{
  "name": "brainhalf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --config vite.preview.config.ts && vite",
    "prepare": "git config core.hooksPath .githooks",
    "build": "vite build && vite build --config vite.preview.config.ts && node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:e2e:seo": "npm run build && playwright test --config playwright.seo.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "runtime:types": "node scripts/wrangler.mjs types src/runtime/generated.d.ts --config wrangler.runtime.jsonc --env-interface RuntimeBindings",
    "runtime:check": "node scripts/wrangler.mjs deploy --config wrangler.runtime.jsonc --dry-run --outdir /tmp/brainhalf-runtime-build",
    "runtime:smoke": "node scripts/check-runtime-local.mjs",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build",
    "lint": "oxlint",
    "test": "vitest run && vitest run --config vitest.runtime.config.ts && node --test scripts/__tests__/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:all-models": "playwright test --config playwright.live.config.ts tests/e2e/multi-model-complexity-suite.spec.ts",
    "test:live:apps": "node scripts/test-live-model-apps.mjs --run",
    "benchmark": "playwright test --config playwright.live.config.ts tests/benchmark/orchestrator.spec.ts",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "wrangler": "node scripts/wrangler.mjs",
    "r2:lifecycle": "node scripts/wrangler.mjs r2 bucket lifecycle add brainhalf-project-backups expire-abandoned-backups --expire-days 365 --force",
    "test:business:apps": "node scripts/test-business-apps.mjs --run",
    "deploy:platform": "node scripts/deploy-platform.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.81",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/openai": "^4.0.65",
    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/sandbox": "0.13.0-next.769.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "agents": "^0.22.0",
    "ai": "^7.0.97",
    "jszip": "^3.10.2",
    "lucide-react": "^1.43.0",
    "pdfjs-dist": "^5.7.284",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "4.135.0",
    "ws": "^8.21.3"
  },
  "overridesNotes": "// is not supported inside npm overrides; the dompurify override exists because monaco-editor 0.56.0 pins dompurify@3.4.8, which carries four advisories (GHSA-c2j3-45gr-mqc4 et al.) fixed in 3.4.13+ \u2014 all patch releases. Drop the override once monaco re-pins.",
  "overrides": {
    "dompurify": "^3.4.15"
  }
}
