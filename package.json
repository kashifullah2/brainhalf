{
  "name": "@workspace/ocr-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:api": "pnpm build && wrangler pages dev",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "deploy": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" wrangler pages deploy dist --project-name brainhalf",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:server",
    "probe:ocr": "node scripts/probe-openai.mjs",
    "db:migrate:local": "wrangler d1 migrations apply brainhalf-ocr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply brainhalf-ocr-db --remote"
  },
  "devDependencies": {
