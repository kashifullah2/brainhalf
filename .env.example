# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

# Dev server
PORT=5000
BASE_PATH=/

# ---------------------------------------------------------------------------
# This file mixes TWO runtimes. Read the labels:
#
#   1. SERVER-ONLY secrets (HUNYUAN_*, OPENAI_*) — read by the Pages Function
#      and the Vite dev proxy. NEVER prefix with VITE_. In production set them
#      in the Cloudflare dashboard as Secrets; for `wrangler pages dev` put
#      them in .dev.vars (see .dev.vars.example).
#
#   2. CLIENT-SAFE config (VITE_*) — inlined into the public browser bundle.
#
# If a value would be catastrophic to publish, it belongs in group 1, never
# behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# === DEFAULT tier: the dedicated OCR model (Hunyuan) ===
# Runs on every page. There is no default key and no fallback: with this unset,
# /api/ocr returns 503 rather than quietly using a committed credential.
HUNYUAN_API_KEY=

# Base URL and model for the Hunyuan endpoint.
HUNYUAN_BASE_URL=https://api.futureppo.top/v1
HUNYUAN_MODEL=hunyuan-ocr

# === ESCALATION tier: OpenAI ===
# Runs ONLY to re-extract a page the default tier read with low confidence
# (below the account's confidence threshold). Its daily allowance is far
# smaller than the default tier's, so it must never become the default path —
# RULES.ocrEscalation in server/rate-limit.ts caps it per account per day.
OPENAI_API_KEY=

# Base URL and model for the OpenAI endpoint.
# NOTE: the .dev.vars example sets OPENAI_MODEL=gpt-5.4-mini — keep the two
# consistent when copying values across.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

# ---------------------------------------------------------------------------
# CLIENT-SAFE config.
#
# WARNING: anything prefixed with VITE_ is inlined into the JavaScript bundle
# and is publicly readable by anyone who opens DevTools. There are no VITE_
# OCR keys: extraction goes through /api/ocr, which holds the credential
# server-side. Never add a browser-side provider key.
# ---------------------------------------------------------------------------

# Base URL of YOUR OWN application backend (batches, documents, storage).
# Leave blank to use same-origin "/api". This must never point at the upstream
# OCR vendor.
VITE_APP_API_BASE_URL=

# Optional override for the file-upload endpoint. Blank = <api base>/storage/upload
VITE_UPLOAD_API_URL=

# Google Identity Services client ID (public by design).
VITE_GOOGLE_CLIENT_ID=

# EmailJS (public by design, but rate-limit and captcha the contact form).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
