// Typechecks the Cloudflare-side code (Pages Functions + shared server lib),
// which runs on the Workers runtime rather than in the browser and therefore
// needs a different set of ambient types than tsconfig.json provides.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    // There is no linter in this project, so the compiler is what keeps
    // unused imports and dead locals out. Nineteen of them had accumulated.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // Tests are excluded because they do not ship to the Workers runtime and some
  // of them legitimately read the filesystem. tsconfig.test.json typechecks
  // them with Node types instead, so nothing goes unchecked -- and keeping
  // "node" out of the types list here is what stops a Node-only API from being
  // used in code that has to run on Workers.
  "include": ["functions/**/*.ts", "server/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
