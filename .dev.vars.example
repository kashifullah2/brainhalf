# Copy to .dev.vars for local `pnpm dev:api`.
#
# Pages Functions read their environment from .dev.vars (NOT .env) when running
# under wrangler. .dev.vars is gitignored; this example file is not.
#
# In production set the same names in the Cloudflare Pages dashboard under
# Settings -> Environment variables, with the *_API_KEY names marked as Secrets.

# Default OCR tier: required. api/ocr.ts returns 503 without it.
HUNYUAN_API_KEY=
# Optional overrides; defaults live in code (functions/api/ocr.ts).
HUNYUAN_BASE_URL=https://api.futureppo.top/v1
HUNYUAN_MODEL=hunyuan-ocr

# Needed by /api/auth/google to validate the `aud` claim of the Google ID token.
# Use the same value as VITE_GOOGLE_CLIENT_ID in .env.
GOOGLE_CLIENT_ID=

# Optional: Cloudflare Email Service binding for password-reset mail.
# Without it, password reset stores the token and logs the link instead of
# sending it (see wrangler.toml).
EMAIL=
