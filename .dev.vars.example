# Copy to .dev.vars for local `pnpm dev:api`.
#
# Pages Functions read their environment from .dev.vars (NOT .env) when running
# under wrangler. .dev.vars is gitignored; this example file is not.
#
# In production set the same names in the Cloudflare Pages dashboard under
# Settings -> Environment variables, with the *_API_KEY names marked as Secrets.

# Default OCR tier: required. api/ocr.ts returns 503 without it.
HUNYUAN_API_KEY=
# Optional overrides; defaults live in code (functions/api/ocr.ts).
HUNYUAN_BASE_URL=https://api.futureppo.top/v1
HUNYUAN_MODEL=hunyuan-ocr

# Needed by /api/auth/google to validate the `aud` claim of the Google ID token.
# Use the same value as VITE_GOOGLE_CLIENT_ID in .env.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Administrators.
#
# Comma-separated email addresses, matched EXACTLY and case-insensitively by
# server/admin.ts. Entries without an "@" are ignored: the check this replaced
# ran in the browser and matched substrings of the signed-in user's email, display
# name and first name, so a bare word like "kashif" made every address containing
# it an administrator -- and `firstName` comes from the signup form.
#
# Unset falls back to the single owner address built into server/admin.ts.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Optional: AWS Textract / Bedrock as the extraction engine.
#
# Server-only, and deliberately NOT VITE_-prefixed -- these are reached from
# server/aws-ocr.ts over signed HTTPS, never from the browser. Set them and AWS
# takes precedence over the Hunyuan/OpenAI tiers above.
#
# AWS_BEDROCK_MODEL both names the vision model and is what enables the Bedrock
# path at all; without it AWS extraction uses Textract only. Textract is never
# used for the escalation tier: it cannot be given instructions, so it is a
# different engine rather than a better one.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for STS / temporary credentials.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# e.g. anthropic.claude-3-5-sonnet-20241022-v2:0 or amazon.nova-lite-v1:0
AWS_BEDROCK_MODEL=

# Primary Email Provider: Resend (https://resend.com)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=BrainHalf <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# Optional: Cloudflare Email Service binding for password-reset mail.
# Without it, password reset stores the token and logs the link instead of
# sending it (see wrangler.toml).
EMAIL=

# ---------------------------------------------------------------------------
# EmailJS — password-reset delivery (functions/api/auth/password-reset.ts).
#
# Secrets, not vars: these three together are enough to send mail through our
# templates. In production set them with
#   wrangler pages secret put EMAILJS_SERVICE_ID --project-name brainhalf
# (and the same for the other three). Leave blank locally to have the reset URL
# logged to the console instead of emailed.
#
# EMAILJS_PWD_TEMPLATE_ID must be the password-reset template. It is read with no
# fallback to the contact template -- a contact template has no reset_url
# placeholder, so a reset mailed through it would arrive with no link and
# EmailJS would still answer 200.
# ---------------------------------------------------------------------------
EMAILJS_SERVICE_ID=
EMAILJS_PWD_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Only needed if /api/contact is ever given the same server-side send.
EMAILJS_TEMPLATE_ID=
