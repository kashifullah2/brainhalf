{
  "name": "@brainhalf/workers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "curl -sf -X POST http://127.0.0.1:8787/api/migrate || echo 'Start workers first: pnpm dev'",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brainhalf/ai": "workspace:*",
    "@brainhalf/db": "workspace:*",
    "ai": "^3.1.11",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.30.10",
    "hono": "^4.3.7",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5",
    "wrangler": "^3.57.1"
  }
}
