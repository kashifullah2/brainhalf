{
  "version": 1,
  "access": "private",
  "steps": [
    {
      "type": "request",
      "name": "Anonymous access denied",
      "path": "/api/items",
      "as": "anonymous",
      "status": 401
    },
    {
      "type": "request",
      "name": "Create a record",
      "path": "/api/items",
      "method": "POST",
      "body": {
        "title": "BrainHalf verification"
      },
      "status": 201,
      "capture": {
        "itemId": "/item/id"
      }
    },
    {
      "type": "database",
      "name": "Prove database persistence",
      "sql": "SELECT title FROM items WHERE id=?",
      "params": [
        "{{itemId}}"
      ],
      "rows": 1,
      "assertions": [
        {
          "pointer": "/0/title",
          "equals": "BrainHalf verification"
        }
      ]
    },
    {
      "type": "request",
      "name": "Other user cannot delete record",
      "path": "/api/items/{{itemId}}",
      "method": "DELETE",
      "as": "otherUser",
      "status": 404
    },
    {
      "type": "request",
      "name": "Read saved record",
      "path": "/api/items",
      "status": 200,
      "assertions": [
        {
          "pointer": "/items/0/title",
          "equals": "BrainHalf verification"
        }
      ]
    },
    {
      "type": "request",
      "name": "Delete own record",
      "path": "/api/items/{{itemId}}",
      "method": "DELETE",
      "status": 200
    },
    {
      "type": "database",
      "name": "Prove database deletion",
      "sql": "SELECT id FROM items WHERE id=?",
      "params": [
        "{{itemId}}"
      ],
      "rows": 0
    },
    {
      "type": "request",
      "name": "Capture test contact message",
      "path": "/api/contact",
      "method": "POST",
      "body": {
        "name": "BrainHalf verification",
        "email": "test@example.com",
        "message": "Managed app verification."
      },
      "status": 201,
      "assertions": [
        {
          "pointer": "/status",
          "equals": "captured"
        }
      ]
    },
    {
      "type": "browser",
      "name": "Open task board",
      "action": "goto",
      "path": "/"
    },
    {
      "type": "browser",
      "name": "Task board heading",
      "action": "expectText",
      "selector": "h1",
      "value": "Brainhalf Task Board"
    },
    {
      "type": "browser",
      "name": "Enter task",
      "action": "fill",
      "selector": "#title",
      "value": "Browser persistence check"
    },
    {
      "type": "browser",
      "name": "Save task",
      "action": "click",
      "selector": "form button"
    },
    {
      "type": "browser",
      "name": "Task appears",
      "action": "expectText",
      "selector": "ul[aria-label=\"Tasks\"]",
      "value": "Browser persistence check"
    },
    {
      "type": "browser",
      "name": "Reload task board",
      "action": "goto",
      "path": "/"
    },
    {
      "type": "browser",
      "name": "Task survives reload",
      "action": "expectText",
      "selector": "ul[aria-label=\"Tasks\"]",
      "value": "Browser persistence check"
    }
  ]
}