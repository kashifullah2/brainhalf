# Cloudflare & Environment
.wrangler
.env
.env.*
# Generated by `wrangler types`; editor-only scaffolding, not part of the
# tsconfig "src" include or the vite build.
worker-configuration.d.ts
src/runtime/generated.d.ts
# Stray `tsc -b` emit artifacts — sources here are TypeScript; compiled
# .js/.d.ts siblings must never be committed (they shadow real imports).
tsconfig.tsbuildinfo
*.tsbuildinfo
vite.config.js
vite.config.d.ts
src/lib/*.js
src/lib/*.d.ts

